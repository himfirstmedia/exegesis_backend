# ====================
# Server Configuration
# ====================
PORT=5001
NODE_ENV=development

# ====================
# Database (Prisma)
# ====================
# Connection pool: pool_timeout=30 (seconds), connection_limit=15, pool_idle_timeout=600000 (10 min)
DATABASE_URL=postgresql://user:password@localhost:5432/exegesis?pool_timeout=30&connection_limit=15

# ====================
# JWT Authentication
# ====================
JWT_SECRET=your-secret-key-change-in-production
# Tokens never expire by default (no `exp` claim). Set to e.g. "30d" to re-enable.
# JWT_EXPIRES_IN=7d

# ====================
# Google OAuth
# ====================
GOOGLE_CLIENT_ID=your-android-google-client-id
GOOGLE_WEB_CLIENT_ID=your-web-google-client-id

# ====================
# Email (SMTP)
# ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=Exegesis App
MAIL_SUPPORT_EMAIL=support@exegesisproject.org
COMPANY_ADDRESS=Exegesis Bible App
UNSUBSCRIBE_URL=mailto:support@exegesisproject.org?subject=unsubscribe

# ====================
# CORS (Allowed Origins)
# ====================
CLIENT_URL=https://app.exegesisproject.org
SITEGRROUND_URL=https://exegesisproject.org

# ====================
# Stripe (Subscription & Sower plans)
# ====================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_LEGACY_SOWER_PRICE_ID=price_...            # $33.33/yr price ID from Stripe Dashboard
STRIPE_COVENANT_SOWER_PRICE_ID=price_...           # $77.77/yr price ID from Stripe Dashboard
FRONTEND_URL=https://app.exegesisproject.org

# ====================
# Redis Cache (optional - falls back to direct reads if unavailable)
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_TTL=86400

# ====================
# Text Translation (LibreTranslate)
# ====================
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_TIMEOUT_MS=15000
LIBRETRANSLATE_MAX_CONCURRENCY=3
LIBRETRANSLATE_MIN_DELAY_MS=300
LIBRETRANSLATE_RETRY_ATTEMPTS=3
LIBRETRANSLATE_RETRY_DELAY_MS=500
TRANSLATION_MAX_TEXT_LENGTH=20000
TRANSLATION_CHUNK_SIZE=1000
TRANSLATION_MAX_BATCH_ITEMS=100
# Daily verse/devotion records contain many prose fields and use a longer
# mobile request timeout than ordinary API calls.
TRANSLATION_TIME_BUDGET_MS=45000

# ====================
# Lordsbook Translate + TTS Gateway
# ====================
LORDSBOOK_GATEWAY_URL=https://translate-api.lordsbook.com
LORDSBOOK_API_KEY=
LORDSBOOK_TIMEOUT_MS=30000
LORDSBOOK_RETRY_ATTEMPTS=3
LORDSBOOK_RETRY_DELAY_MS=500
# TTS playback fails over faster than translation/voice discovery.
LORDSBOOK_TTS_TIMEOUT_MS=25000
LORDSBOOK_TTS_RETRY_ATTEMPTS=1
# Lordsbook becomes much slower and returns 502s under parallel synthesis.
# Serialize upstream work; high-priority playback jumps ahead of prefetch jobs.
LORDSBOOK_MAX_CONCURRENCY=1
LORDSBOOK_BREAKER_THRESHOLD=3
LORDSBOOK_BREAKER_COOLDOWN_MS=300000
# While the breaker is open, /tts/voices may probe for early recovery at this interval.
LORDSBOOK_BREAKER_PROBE_INTERVAL_MS=15000
# This flag is authoritative: true = Lordsbook voices + synthesis,
# false = Edge voices + synthesis. TTS_PROVIDER is retained only for older
# deployments and does not override this flag.
TTS_PROVIDER=edge
LORDSBOOK_TTS_ENABLE=false
LORDSBOOK_DEFAULT_VOICE=bm_george
