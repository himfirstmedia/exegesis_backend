# Database - Railway will provide this via environment variable
# DATABASE_URL="postgresql://user:password@localhost:5432/exegesis"
DATABASE_URL="postgresql://user:password@host:port/railway"

# JWT Configuration
JWT_SECRET="change-me-to-a-random-secret"
JWT_EXPIRES_IN="7d"

# Node Environment
NODE_ENV="production"

# Frontend URL for CORS (set this in Railway)
CLIENT_URL=""

# Mail Configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=Exegesis App

# ElevenLabs TTS (Text-to-Speech)
ELEVENLABS_ENABLED="false"
ELEVENLABS_API_KEY="sk-your-key-here"

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id

# stripe configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_LEGACY_SOWER_PRICE_ID=price_your-price-id
STRIPE_LEGACY_SOWER_MONTHLY_PRICE_ID=price_your-price-id
STRIPE_COVENANT_SOWER_PRICE_ID=price_your-price-id
STRIPE_COVENANT_SOWER_MONTHLY_PRICE_ID=price_your-price-id
FRONTEND_URL=https://your-frontend-url.com
LLM_MODEL=llama3.2:3b
# OLLAMA_HOME=/var/lib/render/.ollama
