generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemUser {
  id                           String             @id @default(uuid())
  firstName                    String             @map("first_name")
  lastName                     String             @map("last_name")
  middleName                   String?            @map("middle_name")
  dateOfBirth                  DateTime?          @map("date_of_birth")
  gender                       String
  maritalStatus                String?            @map("marital_status")
  email                        String             @unique
  phoneNumber                  String             @map("phone_number")
  alternativePhone             String?            @map("alternative_phone")
  addressId                    Int?               @map("address_id")
  ministryGroup                String?            @map("ministry_group")
  servicePosition              String?            @map("service_position")
  spiritualGifts               String?            @map("spiritual_gifts")
  emergencyContactName         String?            @map("emergency_contact_name")
  emergencyContactPhone        String?            @map("emergency_contact_phone")
  emergencyContactRelationship String?            @map("emergency_contact_relationship")
  username                     String             @unique
  password                     String
  profilePhotoUrl              String?            @map("profile_photo_url")
  loginCount                   BigInt             @default(0) @map("login_count")
  status                       Boolean            @default(true)
  lastLogin                    DateTime?          @map("last_login")
  emailVerified                Boolean            @default(false) @map("email_verified")
  isLoggedIn                   Boolean            @default(false) @map("is_logged_in")
  sessionId                    String?            @map("session_id")
  userRole                     BigInt?            @map("user_role")
  accountStatus                String             @default("active") @map("account_status") // active | disabled | suspended
  subscriptionTier             String             @default("free") @map("subscription_tier") // free | legacy_sower | covenant_sower
  accessExpiresAt              DateTime?          @map("access_expires_at")
  stripeCustomerId             String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId         String?            @unique @map("stripe_subscription_id")
  legacySowerSlot              Int?               @map("legacy_sower_slot")
  supporterBadgeText           String?            @map("supporter_badge_text")
  createdOn                    DateTime           @default(now()) @map("created_on")
  updatedOn                    DateTime           @updatedAt @map("updated_on")
  createdBy                    String?            @map("created_by")
  updatedBy                    String?            @map("updated_by")
  subscriptionEvents           SubscriptionEvent[]
  activities                   Activity[]
  dailyDevotionsCreated        DailyDevotion[]    @relation("DailyDevotionCreator")
  dailyExegesisCreated         DailyExegesis[]    @relation("DailyExegesisCreator")
  dailyVersesCreated           DailyVerse[]       @relation("DailyVerseCreator")
  favorites                    Favorite[]
  highlights                   Highlight[]
  exegesisSessions             ExegesisSession[]
  journalEntries               JournalEntry[]
  messages                     Message[]
  notes                        Note[]
  readHistories                ReadHistory[]
  userPlanProgresses           UserPlanProgress[]
  userQuizAnswers              UserQuizAnswer[]
  triviaAnswers                TriviaAnswer[]
  verifications                Verification[]

  @@map("system_users")
}

model SubscriptionEvent {
  id              BigInt      @id @default(autoincrement())
  userId          String      @map("user_id")
  eventType       String      @map("event_type") // created | renewed | cancelled | expired | upgraded | downgraded
  tier            String      // free | legacy_sower | covenant_sower
  stripeEventId   String?     @map("stripe_event_id")
  metadata        Json?
  createdOn       DateTime    @default(now()) @map("created_on")
  user            SystemUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdOn])
  @@map("subscription_events")
}

model SubscriptionTier {
  id             String   @id
  name           String   @unique
  description    String?
  price          Float    @default(0)
  currency       String   @default("usd")
  interval       String   @default("year") // month | year | once | none
  stripeProductId String?  @map("stripe_product_id")
  stripePriceId  String?  @map("stripe_price_id")
  features       Json?
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")
  maxSlots       Int?     @map("max_slots") // null = unlimited
  createdOn      DateTime @default(now()) @map("created_on")
  updatedOn      DateTime @updatedAt @map("updated_on")

  @@map("subscription_tiers")
}

model Role {
  id              BigInt    @id @default(autoincrement())
  roleName        String    @unique @map("role_name")
  roleDescription String    @map("role_description")
  createdBy       String?   @map("created_by")
  createdOn       DateTime? @map("created_on")
  updatedBy       String?   @map("updated_by")
  updatedOn       DateTime? @map("updated_on")

  @@map("role")
}

model Activity {
  id            BigInt     @id @default(autoincrement())
  userId        String     @map("user_id")
  username      String?
  email         String?
  loggedInAt    DateTime   @default(now()) @map("logged_in_at")
  loggedOutAt   DateTime?  @map("logged_out_at")
  success       Boolean    @default(true)
  failureReason String?    @map("failure_reason")
  ip            String?
  userAgent     String?    @map("user_agent")
  browserName   String?    @map("browser_name")
  os            String?
  deviceType    String?    @map("device_type")
  deviceName    String?    @map("device_name")
  engine        String?
  locale        String?
  user          SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedInAt])
  @@index([ip])
  @@map("activity")
}

model Verification {
  id               BigInt      @id @default(autoincrement())
  code             String
  verificationType String      @map("verification_type")
  emailAddress     String?     @map("email_address")
  createdBy        String?     @map("created_by")
  createdOn        DateTime    @default(now()) @map("created_on")
  expiresAt        DateTime    @map("expires_at")
  status           Boolean     @default(false)
  user             SystemUser? @relation(fields: [createdBy], references: [id])

  @@map("verification")
}

model DailyVerse {
  id           BigInt     @id @default(autoincrement())
  bookName     String     @map("book_name")
  chapter      BigInt
  verseNumber  BigInt     @map("verse_number")
  bibleVersion String?    @map("bible_version")
  displayDate  DateTime   @map("display_date")
  displayTime  DateTime?  @map("display_time")
  reflection   String?    @map("reflection")
  explanation  String?    @map("explanation")
  learnMore    String?    @map("learn_more")
  createdBy    String     @map("created_by")
  createdOn    DateTime   @default(now()) @map("created_on")
  updatedBy    String?    @map("updated_by")
  updatedOn    DateTime   @updatedAt @map("updated_on")
  isPublished  Boolean    @default(false) @map("is_published")
  user         SystemUser @relation("DailyVerseCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([displayDate])
  @@index([bookName, chapter, verseNumber])
  @@index([isPublished, displayDate])
  @@map("daily_verse")
}

model DailyDevotion {
  id          BigInt     @id @default(autoincrement())
  title       String
  content     String
  bookName    String?    @map("book_name")
  chapter     BigInt?
  verseNumber BigInt?    @map("verse_number")
  displayDate DateTime   @map("display_date")
  displayTime DateTime?  @map("display_time")
  createdBy   String     @map("created_by")
  createdOn   DateTime   @default(now()) @map("created_on")
  updatedBy   String?    @map("updated_by")
  updatedOn   DateTime   @updatedAt @map("updated_on")
  isPublished Boolean    @default(false) @map("is_published")
  user        SystemUser @relation("DailyDevotionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([displayDate])
  @@index([isPublished, displayDate])
  @@map("daily_devotion")
}

model DailyExegesis {
  id               BigInt      @id @default(autoincrement())
  title            String
  passageReference String      @map("passage_reference")
  introduction     String?
  contextSummary   String?     @map("context_summary")
  teachingBody     String      @map("teaching_body")
  application      String?
  prayer           String?
  tags             String?
  displayDate      DateTime    @map("display_date")
  displayTime      DateTime?   @map("display_time")
  createdBy        String?     @map("created_by")
  createdOn        DateTime    @default(now()) @map("created_on")
  updatedBy        String?     @map("updated_by")
  updatedOn        DateTime    @updatedAt @map("updated_on")
  isPublished      Boolean     @default(false) @map("is_published")
  user             SystemUser? @relation("DailyExegesisCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([displayDate])
  @@index([isPublished, displayDate])
  @@map("daily_exegesis")
}

model ReadHistory {
  id          BigInt      @id @default(autoincrement())
  bookName    String      @map("book_name")
  chapter     BigInt
  verseNumber BigInt      @map("verse_number")
  createdBy   String?     @map("created_by")
  createdOn   DateTime?   @map("created_on")
  updatedBy   String?     @map("updated_by")
  updatedOn   DateTime?   @map("updated_on")
  user        SystemUser? @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([createdBy, bookName, chapter, verseNumber])
  @@map("read_history")
}

model Favorite {
  id          BigInt      @id @default(autoincrement())
  bookName    String      @map("book_name")
  chapter     BigInt
  verseNumber BigInt      @map("verse_number")
  createdBy   String?     @map("created_by")
  createdOn   DateTime?   @map("created_on")
  updatedBy   String?     @map("updated_by")
  updatedOn   DateTime?   @map("updated_on")
  user        SystemUser? @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([createdBy, bookName, chapter, verseNumber])
  @@map("favorite")
}

model Highlight {
  id          BigInt      @id @default(autoincrement())
  bookName    String      @map("book_name")
  chapter     BigInt
  verseNumber BigInt      @map("verse_number")
  colorId     BigInt      @map("color_id")
  note        String?
  createdBy   String?     @map("created_by")
  createdOn   DateTime?   @map("created_on")
  updatedBy   String?     @map("updated_by")
  updatedOn   DateTime?   @map("updated_on")
  user        SystemUser? @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("high_lights")
}

model Note {
  id          BigInt      @id @default(autoincrement())
  bookName    String      @map("book_name")
  chapter     BigInt
  verseNumber BigInt      @map("verse_number")
  note        String?
  createdBy   String?     @map("created_by")
  createdOn   DateTime?   @map("created_on")
  updatedBy   String?     @map("updated_by")
  updatedOn   DateTime?   @map("updated_on")
  user        SystemUser? @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([createdBy, bookName, chapter, verseNumber])
  @@map("note")
}

model VerseExplanation {
  id           BigInt    @id @default(autoincrement())
  bookName     String    @map("book_name")
  chapter      BigInt
  verseNumber  BigInt    @map("verse_number")
  explanation  String?
  learnMore    String?   @map("learn_more")
  bibleVersion String?   @map("bible_version")
  promptIds    String?   @map("prompt_ids")
  createdBy    String?   @map("created_by")
  createdOn    DateTime? @map("created_on")
  updatedBy    String?   @map("updated_by")
  updatedOn    DateTime? @map("updated_on")

  @@unique([bookName, chapter, verseNumber])
  @@map("verse_explanations")
}

model Message {
  id            BigInt      @id @default(autoincrement())
  message       String
  recipient     String
  subject       String?
  attachment    String?
  attachmentTwo String?     @map("attachment_two")
  sendCount     BigInt      @default(0) @map("send_count")
  failCount     Int         @default(0) @map("fail_count")
  maxRetries    Int         @default(3) @map("max_retries")
  lastError     String?     @map("last_error")
  status        String      @default("PENDING")
  sentOn        DateTime?   @map("sent_on")
  createdBy     String?     @map("created_by")
  createdOn     DateTime?   @map("created_on")
  updatedBy     String?     @map("updated_by")
  updatedOn     DateTime?   @map("updated_on")
  user          SystemUser? @relation(fields: [createdBy], references: [id])

  @@map("messages")
}

model ReadingPlan {
  id               BigInt             @id @default(autoincrement())
  planId           String             @unique
  title            String
  description      String?
  totalDays        Int                @map("total_days")
  questionsEnabled Boolean            @default(false) @map("questions_enabled")
  category         String?
  difficulty       String?
  isActive         Boolean            @default(true) @map("is_active")
  createdBy        String?            @map("created_by")
  createdOn        DateTime?          @map("created_on")
  updatedBy        String?            @map("updated_by")
  updatedOn        DateTime?          @map("updated_on")
  dailyAssignments DailyAssignment[]
  quizQuestions    QuizQuestion[]
  userPlanProgress UserPlanProgress[]

  @@map("reading_plans")
}

model DailyAssignment {
  id                  BigInt      @id @default(autoincrement())
  planId              String      @map("plan_id")
  dayNumber           Int         @map("day_number")
  title               String?
  chaptersJson        String      @map("chapters_json")
  reflectionQuestions String?     @map("reflection_questions")
  createdBy           String?     @map("created_by")
  createdOn           DateTime?   @map("created_on")
  updatedBy           String?     @map("updated_by")
  updatedOn           DateTime?   @map("updated_on")
  readingPlan         ReadingPlan @relation(fields: [planId], references: [planId], onDelete: Cascade)

  @@index([planId])
  @@map("daily_assignments")
}

model QuizQuestion {
  id            BigInt      @id @default(autoincrement())
  planId        String      @map("plan_id")
  dayNumber     Int         @map("day_number")
  question      String
  optionsJson   String      @map("options_json")
  correctAnswer Int         @map("correct_answer")
  explanation   String?
  createdBy     String?     @map("created_by")
  createdOn     DateTime?   @map("created_on")
  updatedBy     String?     @map("updated_by")
  updatedOn     DateTime?   @map("updated_on")
  readingPlan   ReadingPlan @relation(fields: [planId], references: [planId], onDelete: Cascade)

  @@index([planId])
  @@map("quiz_questions")
}

model UserPlanProgress {
  id                BigInt      @id @default(autoincrement())
  userId            String      @map("user_id")
  planId            String      @map("plan_id")
  startDate         DateTime    @map("start_date")
  completedDaysJson String?     @map("completed_days_json")
  lastCompletedDate DateTime?   @map("last_completed_date")
  streak            Int         @default(0)
  isCompleted       Boolean     @default(false) @map("is_completed")
  completedDate     DateTime?   @map("completed_date")
  createdBy         String?     @map("created_by")
  createdOn         DateTime?   @map("created_on")
  updatedBy         String?     @map("updated_by")
  updatedOn         DateTime?   @map("updated_on")
  readingPlan       ReadingPlan @relation(fields: [planId], references: [planId], onDelete: Cascade)
  user              SystemUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
  @@map("user_plan_progress")
}

model UserQuizAnswer {
  id            BigInt     @id @default(autoincrement())
  userId        String     @map("user_id")
  planId        String     @map("plan_id")
  dayNumber     Int        @map("day_number")
  questionId    BigInt     @map("question_id")
  userAnswer    Int        @map("user_answer")
  isCorrect     Boolean    @map("is_correct")
  createdBy     String?    @map("created_by")
  createdOn     DateTime?  @map("created_on")
  updatedBy     String?    @map("updated_by")
  updatedOn     DateTime?  @map("updated_on")
  numberAttempt Int?       @map("number_attempt")
  user          SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([planId])
  @@map("user_quiz_answers")
}

model JournalEntry {
  id               BigInt            @id @default(autoincrement())
  userId           String            @map("user_id")
  title            String?
  content          String
  bookName         String?           @map("book_name")
  chapter          BigInt?           @map("chapter")
  verseNumber      BigInt?           @map("verse_number")
  category         String?           @default("general")
  mood             String?
  prayers          String?
  gratitude        String?
  learnings        String?
  application      String?
  isPublished      Boolean           @default(false) @map("is_published")
  isFavorite       Boolean           @default(false) @map("is_favorite")
  strongsWords     String?           @map("strongs_words") // JSON: [{ strongsId, surfaceText, lemma }]
  strongsIds       String?           @map("strongs_ids") // Comma-separated: "H7225,G26,G2889"
  source           String            @default("manual") @map("source") // "manual" | "exegesis-lab"
  tags             String?           @map("tags")
  createdOn        DateTime          @default(now()) @map("created_on")
  updatedOn        DateTime          @updatedAt @map("updated_on")
  createdBy        String?           @map("created_by")
  updatedBy        String?           @map("updated_by")
  exegesisSessions ExegesisSession[]
  user             SystemUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdOn])
  @@index([bookName, chapter])
  @@index([category])
  @@map("journal_entries")
}

model JournalPrompt {
  id          BigInt   @id @default(autoincrement())
  prompt      String
  category    String   @default("general")
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  bookName    String?  @map("book_name")
  chapter     BigInt?  @map("chapter")
  verseNumber BigInt?  @map("verse_number")
  createdBy   String?  @map("created_by")
  createdOn   DateTime @default(now()) @map("created_on")
  updatedBy   String?  @map("updated_by")
  updatedOn   DateTime @updatedAt @map("updated_on")

  @@index([category])
  @@index([isActive])
  @@index([bookName])
  @@map("journal_prompts")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by")
  updatedOn DateTime @updatedAt @map("updated_on")

  @@map("site_settings")
}

model JournalTemplate {
  id          BigInt   @id @default(autoincrement())
  name        String
  description String?
  category    String   @default("general")
  promptsJson String   @map("prompts_json")
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  createdBy   String?  @map("created_by")
  createdOn   DateTime @default(now()) @map("created_on")
  updatedBy   String?  @map("updated_by")
  updatedOn   DateTime @updatedAt @map("updated_on")

  @@index([category])
  @@index([isActive])
  @@map("journal_templates")
}

model StrongsDictionary {
  strongsId       String      @id
  originalWord    String?
  transliteration String?
  pronunciation   String?
  shortDefinition String      @map("short_definition")
  fullDefinition  String?     @map("full_definition")
  language        String      @default("greek")
  usageCount      Int?        @map("usage_count")
  partOfSpeech    String?     @map("part_of_speech")
  grammaticalCase String?     @map("grammatical_case")
  gender          String?
  number          String?
  crossReferences String?     @map("cross_references")
  createdOn       DateTime    @default(now()) @map("created_on")
  verseWords      VerseWord[]

  @@map("strongs_dictionary")
}

model SearchIndex {
  id          BigInt   @id @default(autoincrement())
  translation String
  bookNumber  Int      @map("book_number")
  bookName    String   @map("book_name")
  chapter     Int
  verse       Int
  verseText   String   @map("verse_text")
  verseTsv    Unsupported("tsvector")? @map("verse_tsv")

  @@index([translation, bookNumber])
  @@index([verseTsv], type: Gin)
  @@map("search_index")
}

model VerseWord {
  id          BigInt             @id @default(autoincrement())
  translation String             @default("BSB")
  bookName    String             @map("book_name")
  chapter     BigInt
  verse       BigInt
  wordOrder   Int                @map("word_order")
  surfaceText String             @map("surface_text")
  strongsId   String?            @map("strongs_id")
  lemma       String?
  morphology  String?
  strongs     StrongsDictionary? @relation(fields: [strongsId], references: [strongsId])

  @@unique([translation, bookName, chapter, verse, wordOrder])
  @@index([translation, bookName, chapter, verse])
  @@index([strongsId])
  @@map("verse_words")
}

model ExegesisSession {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  passageRef       String        @map("passage_ref")
  bookName         String        @map("book_name")
  chapter          BigInt
  verseStart       BigInt?       @map("verse_start")
  verseEnd         BigInt?       @map("verse_end")
  currentStage     String        @default("look") @map("current_stage") // look | listen | learn | abide | completed
  lookNotes        String?       @map("look_notes")
  lookPromptsJson  String?       @map("look_prompts_json")
  listenCompleted  Boolean       @default(false) @map("listen_completed")
  listenDuration   Int?          @map("listen_duration") // seconds chosen
  listenElapsed    Int?          @map("listen_elapsed") // seconds elapsed mid-timer
  learnNotes       String?       @map("learn_notes")
  abideReflection  String?       @map("abide_reflection")
  abidePrayer      String?       @map("abide_prayer")
  abideApplication String?       @map("abide_application")
  abideTags        String?       @map("abide_tags")
  strongsWords     String?       @map("strongs_words") // JSON array of studied Strong's words
  strongsIds       String?       @map("strongs_ids") // Comma-separated Strong's IDs
  isPublic         Boolean       @default(false) @map("is_public")
  journalEntryId   BigInt?       @map("journal_entry_id")
  completed        Boolean       @default(false)
  createdOn        DateTime      @default(now()) @map("created_on")
  updatedOn        DateTime      @updatedAt @map("updated_on")
  user             SystemUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntry     JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, completed])
  @@index([userId, createdOn])
  @@map("exegesis_sessions")
}

model BibleTopic {
  id          BigInt   @id @default(autoincrement())
  topicName   String   @unique @map("topic_name")
  description String?
  verseRefs   String?  @map("verse_refs")
  createdOn   DateTime @default(now()) @map("created_on")
  updatedOn   DateTime @updatedAt @map("updated_on")

  @@index([topicName])
  @@map("bible_topics")
}

model TriviaQuestion {
  id            BigInt         @id @default(autoincrement())
  question      String
  optionsJson   String         @map("options_json")
  correctAnswer Int            @map("correct_answer")
  explanation   String?
  bookName      String?        @map("book_name")
  chapter       BigInt?        @map("chapter")
  verseNumber   BigInt?        @map("verse_number")
  category      String?        @default("general")
  difficulty    String?        @default("medium") // easy | medium | hard
  isActive      Boolean        @default(true) @map("is_active")
  createdBy     String?        @map("created_by")
  createdOn     DateTime       @default(now()) @map("created_on")
  updatedBy     String?        @map("updated_by")
  updatedOn     DateTime       @updatedAt @map("updated_on")
  triviaAnswers TriviaAnswer[]

  @@index([category])
  @@index([difficulty])
  @@index([isActive])
  @@map("trivia_questions")
}

model TriviaAnswer {
  id             BigInt         @id @default(autoincrement())
  userId         String         @map("user_id")
  questionId     BigInt         @map("question_id")
  selectedAnswer Int            @map("selected_answer")
  isCorrect      Boolean        @map("is_correct")
  answeredOn     DateTime       @default(now()) @map("answered_on")
  user           SystemUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       TriviaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
  @@map("trivia_answers")
}

model VerseResource {
  id               BigInt   @id @default(autoincrement())
  bookName         String   @map("book_name")
  chapter          BigInt
  verseStart       BigInt   @map("verse_start")
  verseEnd         BigInt?  @map("verse_end")
  commentaries     String? // JSON array of { author, title, text }
  crossReferences  String?  @map("cross_references") // JSON array
  wordStudies      String?  @map("word_studies") // JSON array
  dictionaryTerms  String?  @map("dictionary_terms") // JSON array
  interlinearWords String?  @map("interlinear_words") // JSON array
  relatedTopics    String?  @map("related_topics") // JSON array
  language         String   @default("en")
  createdBy        String?  @map("created_by")
  createdOn        DateTime @default(now()) @map("created_on")
  updatedBy        String?  @map("updated_by")
  updatedOn        DateTime @updatedAt @map("updated_on")

  @@unique([bookName, chapter, verseStart])
  @@index([bookName, chapter])
  @@map("verse_resources")
}

model ChapterStudyTool {
  id          BigInt  @id @default(autoincrement())
  bookName    String  @map("book_name")
  chapter     BigInt
  toolType    String  @map("tool_type") // COMMAND | PROMISE | WARNING | REPEATED_WORD | TRANSITION | CONTRAST
  label       String
  description String?
  verseRefs   Json    @map("verse_refs") // [{verse, excerpt}]
  strongsIds  Json?   @map("strongs_ids") // [strongsId, ...]
  order       Int     @default(0)

  @@unique([bookName, chapter, toolType, label])
  @@index([bookName, chapter])
  @@map("chapter_study_tools")
}

model PopularSearchLog {
  id          BigInt   @id @default(autoincrement())
  query       String
  scope       String   @default("bible") // bible | strongs | journal | topics | lemma
  language    String   @default("en")
  userId      String?  @map("user_id")
  ipAddress   String?  @map("ip_address")
  createdOn   DateTime @default(now()) @map("created_on")

  @@index([createdOn])
  @@index([query, scope, createdOn])
  @@index([scope, createdOn])
  @@map("popular_search_log")
}

model BookPrologue {
  bookName          String   @id @map("book_name")
  author            String?
  audience          String?
  dateWritten       String?  @map("date_written")
  locationWritten   String?  @map("location_written")
  purpose           String?
  keyTheme          String?  @map("key_theme")
  summary           String?
  mainThemes        Json?    @map("main_themes")
  christConnection  String?  @map("christ_connection")
  createdBy         String?  @map("created_by")
  createdOn         DateTime @default(now()) @map("created_on")
  updatedBy         String?  @map("updated_by")
  updatedOn         DateTime @updatedAt @map("updated_on")

  @@map("book_prologues")
}
